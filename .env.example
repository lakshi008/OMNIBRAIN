# ==============================================================================
# OMNIBRAIN Environment Configuration
# ==============================================================================

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Qdrant Vector Store Configuration
# Use ':memory:' for fast in-memory testing or provide a remote Qdrant endpoint URL
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION=omnibrain_documents
QDRANT_TIMEOUT=10.0

# Embedding Provider Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM Answer Synthesis Configuration
# Supported providers: 'groq' | 'openai' | 'openai_compatible' | 'ollama' | 'custom'
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# LLM_BASE_URL is optional (defaults: Groq->https://api.groq.com/openai/v1, OpenAI->https://api.openai.com/v1)
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30.0

# Frontend Configuration (in frontend/.env)
# VITE_API_BASE_URL=http://localhost:8000
